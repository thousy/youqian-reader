{
  "name": "youqian-reader",
  "version": "2.0.2",
  "description": "多格式电子书阅读器 - 支持 EPUB, PDF, AZW3, MOBI, TXT",
  "main": "out/main/index.js",
  "author": "YouQian Reader",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "publish": "node scripts/publish.js"
  },
  "build": {
    "appId": "com.youqian.reader.app",
    "productName": "YouQian Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraFiles": [
      {
        "from": "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "to": "resources/pdf.worker.min.mjs"
      }
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB 电子书",
          "description": "使用 YouQian Reader 打开 EPUB 文件",
          "icon": "build/icon.ico"
        },
        {
          "ext": "pdf",
          "name": "PDF 文档",
          "description": "使用 YouQian Reader 打开 PDF 文件",
          "icon": "build/icon.ico"
        },
        {
          "ext": "azw3",
          "name": "AZW3 电子书",
          "description": "使用 YouQian Reader 打开 AZW3 文件",
          "icon": "build/icon.ico"
        },
        {
          "ext": "mobi",
          "name": "MOBI 电子书",
          "description": "使用 YouQian Reader 打开 MOBI 文件",
          "icon": "build/icon.ico"
        },
        {
          "ext": "txt",
          "name": "文本文件",
          "description": "使用 YouQian Reader 打开 TXT 文件",
          "icon": "build/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "chardet": "^2.0.0",
    "cheerio": "^1.2.0",
    "electron-store": "^8.2.0",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  }
}
